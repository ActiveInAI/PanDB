{
  "name": "pandb",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config apps/desktop/vite.config.ts",
    "dev:tauri": "node scripts/dev-tauri.mjs",
    "dev:web": "vite --config apps/desktop/vite.config.ts --port 5173 --mode web",
    "dev:backend": "node scripts/dev-backend.mjs",
    "dev:full:win": ".\\scripts\\dev-full.bat",
    "build:packages": "pnpm --filter @dbx-app/cli build && pnpm --filter @dbx-app/mcp-server build && pnpm --filter @dbx-app/plugin-cli build",
    "test:packages": "pnpm --filter @dbx-app/cli test && pnpm --filter @dbx-app/mcp-server test && pnpm --filter @dbx-app/plugin-cli test",
    "pack:packages": "rm -rf /tmp/dbx-pack-check && mkdir -p /tmp/dbx-pack-check && pnpm --filter @dbx-app/cli pack --pack-destination /tmp/dbx-pack-check && pnpm --filter @dbx-app/mcp-server pack --pack-destination /tmp/dbx-pack-check && pnpm --filter @dbx-app/plugin-cli pack --pack-destination /tmp/dbx-pack-check",
    "verify:package-install": "node scripts/verify-package-install.mjs /tmp/dbx-pack-check",
    "verify:plugin-cli-package": "node scripts/verify-plugin-cli-package.mjs",
    "test:cli:migration": "node scripts/verify-cli-migration.mjs",
    "benchmark:cli": "node scripts/benchmark-cli.mjs",
    "publish:dry-run": "pnpm build:packages && pnpm pack:packages && pnpm verify:package-install",
    "release": "node scripts/release.mjs",
    "release:agents": "node scripts/release.mjs agents",
    "release:app": "node scripts/release.mjs app",
    "release:packages": "node scripts/release.mjs packages",
    "test:release": "node --test scripts/release.test.mjs",
    "build:knowledge-base": "node scripts/build-knowledge-base.mjs",
    "generate:connection-types": "node scripts/sync-connection-types.mjs",
    "check:connection-types": "node scripts/sync-connection-types.mjs --check",
    "pretypecheck": "pnpm generate:connection-types",
    "typecheck": "vue-tsc --noEmit --project apps/desktop/tsconfig.json",
    "build": "node scripts/clean-desktop-dist.mjs && vite build --config apps/desktop/vite.config.ts",
    "build:docs-export": "vite build --config apps/desktop/vite.docs-export.config.ts",
    "build:checked": "pnpm typecheck && pnpm build",
    "check": "node scripts/run-check.mjs",
    "db:env": "node scripts/database-env.mjs",
    "test:db-env": "node --test scripts/database-env.test.mjs",
    "test:architecture": "node --test scripts/core-architecture.test.mjs",
    "test:ai-html-canary": "node scripts/ai-html-runtime-canary.mjs",
    "bench:redis-key-search": "node scripts/bench/redis-key-search.mjs",
    "bench:mongodb-count": "node scripts/bench/mongodb-count.mjs",
    "bench:sidebar-large-schema": "vitest bench apps/desktop/src/lib/sidebar/sidebarLargeSchema.bench.ts",
    "bench:startup": "node --import tsx scripts/bench/startup-bundle.mjs",
    "bench:table-import": "cargo run -p dbx-core --no-default-features --example table_import_bench --release --",
    "lint": "oxlint --vue-plugin apps/desktop/src --max-warnings=61",
    "fmt": "oxfmt \"apps/desktop/src/**/*.{ts,vue}\"",
    "pretest": "pnpm generate:connection-types",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview --config apps/desktop/vite.config.ts",
    "tauri": "tauri",
    "prepare": "husky"
  },
  "dependencies": {
    "@babel/runtime": "8.0.8",
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.15",
    "@dbx-app/mongo-shell": "workspace:^",
    "@internationalized/date": "3.12.4",
    "@lezer/common": "1.5.4",
    "@lezer/highlight": "1.2.5",
    "@lucide/vue": "1.64.0",
    "@msgpack/msgpack": "3.1.3",
    "@noble/ciphers": "2.4.0",
    "@replit/codemirror-vim": "6.4.0",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "2.5.0",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@tauri-apps/plugin-fs": "2.7.1",
    "@tauri-apps/plugin-shell": "2.6.0",
    "@tauri-apps/plugin-updater": "2.14.1",
    "@uiw/codemirror-theme-duotone": "4.25.12",
    "@uiw/codemirror-theme-material": "4.25.12",
    "@uiw/codemirror-theme-nord": "4.25.12",
    "@uiw/codemirror-theme-okaidia": "4.25.12",
    "@uiw/codemirror-theme-vscode": "4.25.12",
    "@uiw/codemirror-theme-xcode": "4.25.12",
    "@vue-flow/background": "1.3.2",
    "@vue-flow/controls": "1.1.3",
    "@vue-flow/core": "1.48.2",
    "@vue-flow/minimap": "1.5.4",
    "@vueuse/core": "15.0.0",
    "cbor-x": "1.6.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "codemirror": "6.0.2",
    "cytoscape": "3.34.4",
    "cytoscape-fcose": "2.2.0",
    "dayjs": "1.11.23",
    "diff": "9.0.0",
    "dom-to-image-more": "3.11.0",
    "echarts": "6.1.0",
    "elkjs": "0.12.1",
    "fast-xml-parser": "5.11.2",
    "leaflet": "1.9.4",
    "marked": "18.1.2",
    "pako": "3.0.3",
    "pinia": "4.1.0",
    "pinyin-pro": "3.29.5",
    "proj4": "2.22.0",
    "reka-ui": "2.11.0",
    "shiki": "4.5.0",
    "smol-toml": "1.9.1",
    "splitpanes": "4.1.2",
    "sql-formatter": "15.9.0",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "vue": "3.5.44",
    "vue-echarts": "8.3.2",
    "vue-i18n": "11.4.16",
    "vue-virtual-scroller": "3.0.5"
  },
  "devDependencies": {
    "@lezer/highlight": "1.2.5",
    "@oxfmt/binding-darwin-arm64": "0.75.0",
    "@oxlint/binding-darwin-arm64": "1.90.0",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.4",
    "@types/leaflet": "1.9.22",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "5.0.5",
    "@xmldom/xmldom": "0.9.12",
    "fake-indexeddb": "6.2.6",
    "fzstd": "0.1.1",
    "happy-dom": "21.0.4",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13",
    "yaml": "2.9.1"
  },
  "lint-staged": {
    "apps/desktop/src/**/*.{ts,vue}": "oxfmt"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@12.16.1"
}
